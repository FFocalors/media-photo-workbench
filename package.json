{
  "name": "media-photo-workbench",
  "version": "0.16.0",
  "private": true,
  "description": "Windows desktop photo workflow workbench for campus media teams.",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "pnpm dev:electron",
    "dev:web": "vite --host 0.0.0.0",
    "dev:electron": "pnpm build:server && concurrently -k \"vite --host 0.0.0.0\" \"wait-on tcp:5173 && electron .\"",
    "build:server": "tsc -p tsconfig.server.json && node -e \"require('fs').writeFileSync('dist-server/package.json','{\\\"type\\\":\\\"commonjs\\\"}\\n')\"",
    "setup:electron": "pnpm rebuild electron",
    "rebuild:sqlite": "pnpm rebuild better-sqlite3",
    "build": "tsc -p tsconfig.json --noEmit && pnpm build:server && vite build",
    "dist:portable": "pnpm build && electron-builder --win zip",
    "dist:win": "pnpm build && electron-builder --win nsis",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "build": {
    "appId": "cn.media-photo-workbench.app",
    "productName": "Media Photo Workbench",
    "directories": {
      "output": "release-pack"
    },
    "files": [
      "dist/**/*",
      "dist-server/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build",
        "to": "build",
        "filter": [
          "icon.png",
          "icon.ico"
        ]
      },
      {
        "from": "node_modules",
        "to": "node_modules",
        "filter": [
          "**/*",
          "!**/.cache/**/*"
        ]
      }
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*",
      "node_modules/sharp/**/*",
      "node_modules/@img/**/*",
      "node_modules/@emnapi/**/*",
      "node_modules/detect-libc/**/*"
    ],
    "forceCodeSigning": false,
    "npmRebuild": true,
    "win": {
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "target": [
        "zip",
        "nsis"
      ],
      "artifactName": "MediaPhotoWorkbench-${version}-${arch}.${ext}"
    },
    "nsis": {
      "artifactName": "MediaPhotoWorkbench-${version}-setup-${arch}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "融媒体图片工作台",
      "uninstallDisplayName": "融媒体图片工作台",
      "runAfterFinish": false,
      "deleteAppDataOnUninstall": false
    }
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "better-sqlite3",
      "sharp"
    ]
  },
  "dependencies": {
    "better-sqlite3": "11.10.0",
    "cors": "^2.8.5",
    "ee-first": "^1.1.1",
    "exifr": "^7.1.3",
    "express": "^5.0.0",
    "fs-extra": "^11.0.0",
    "lucide-react": "^0.468.0",
    "pino": "^9.0.0",
    "pino-pretty": "^13.0.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/cors": "^2.8.0",
    "@types/express": "^5.0.0",
    "@types/fs-extra": "^11.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "electron": "^33.0.0",
    "electron-builder": "^26.8.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "wait-on": "^8.0.1"
  }
}
